{
  "name": "quiz-arena",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter @quiz/web --filter @quiz/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter '!@quiz/e2e' test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "setup:local": "cp -n apps/worker/.dev.vars.example apps/worker/.dev.vars; pnpm --filter @quiz/worker db:migrate:local",
    "test:e2e": "pnpm --filter @quiz/e2e test",
    "test:load": "node tests/load/load.mjs 150 15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "license": "MIT"
}
