{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-arena",
      "database_id": "85cc0177-0b7e-49af-a32c-d160ed1117b2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 21 * * *"] },
  "observability": { "enabled": true },
  "vars": { "DEV_LOGIN": "0" },
  "env": {
    "staging": {
      "name": "quiz-arena-staging",
      "durable_objects": { "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
      "observability": { "enabled": true },
      // DEV_LOGIN is deliberately absent (= off). Switch it on only while load testing:
      //   npx wrangler secret put DEV_LOGIN --env staging   (value 1), and delete it afterwards.
      "vars": {},
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quiz-arena-staging",
          "database_id": "a7339036-7458-45ac-bb3e-a6d70c03637e",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
