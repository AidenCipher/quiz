{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-arena",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 21 * * *"] },
  "observability": { "enabled": true },
  "vars": { "DEV_LOGIN": "0" },
  "env": {
    "staging": {
      "name": "quiz-arena-staging",
      "durable_objects": { "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quiz-arena-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "DEV_LOGIN": "0" }
    }
  }
}
