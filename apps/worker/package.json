    "@vitest/snapshot": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@quiz/shared": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
